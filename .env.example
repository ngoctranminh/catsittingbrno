# Public URL of the site (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.example.cz

# Enquiry form delivery via Resend (https://resend.com).
# Until all three are set, the form shows "not active yet" and sends nothing.
RESEND_API_KEY=
# Where enquiries are delivered (comma-separated for several addresses).
INQUIRY_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. "Catsitting Brno <poptavky@example.cz>".
INQUIRY_FROM_EMAIL=
